PORT=5000
MONGO_URI=mongodb+srv://<TU_USUARIO>:<TU_PASSWORD>@<TU_CLUSTER>.mongodb.net/stockSistem_dev
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_al_menos_32_chars
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
# Nivel de logging: debug | info | warn | error (default: debug en dev, info en prod)
LOG_LEVEL=debug
ADMIN_EMAIL=nexus@code.com
ADMIN_PASSWORD=nexus2026
EMPLEADO_EMAIL=empleado@tutienda.com
EMPLEADO_PASSWORD=empleado123

# --- Mail (opcional: si no se configuran, el mail del cierre se omite) ---
# Modo API (recomendado): usar BREVO_API_KEY
BREVO_API_KEY=xkeysib-...
# Modo SMTP: usar MAIL_HOST / MAIL_PORT / MAIL_USER / MAIL_PASS
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=tu_usuario@smtp-brevo.com
MAIL_PASS=tu_password_smtp
# Destinatario y remitente (obligatorios en ambos modos)
MAIL_TO=tu_email@gmail.com
MAIL_FROM="NexusCode" <tu_email@gmail.com>

# --- Push notifications (web-push / VAPID) ---
# Generá las claves con: npx web-push generate-vapid-keys
# La pública también va en frontend/.env como VITE_VAPID_PUBLIC_KEY
# IMPORTANTE: si dejás VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY vacías, el push se
# desactiva solo (sin errores). Si las completás, deben ser claves VÁLIDAS.
VAPID_PUBLIC_KEY=tu_clave_publica_vapid
VAPID_PRIVATE_KEY=tu_clave_privada_vapid
VAPID_SUBJECT=mailto:tu_email@gmail.com
