{
  "name": "stock-tienda",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "npx concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run frontend\"",
    "setup": "npm ci && npm ci --prefix backend && npm ci --include=dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "spawn-command": "1.0.0"
  }
}
