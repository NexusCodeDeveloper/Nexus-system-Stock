# URL de la API. En desarrollo, si se omite, se usa http://localhost:5000/api.
# En producción (build) debe ser /api porque el backend sirve el frontend.
VITE_API_URL=http://localhost:5000/api
# Clave pública de las notificaciones push (web-push VAPID). No es un secreto.
VITE_VAPID_PUBLIC_KEY=tu_clave_publica_vapid
# Reportar errores del navegador a la consola del backend (default: true). Usar "false" para desactivar.
VITE_ERROR_REPORTING=true
